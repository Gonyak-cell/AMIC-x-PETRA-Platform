# ===================================================================
# AMIC x PETRA Platform — 프로덕션 환경변수
# ===================================================================
#
# 사용법:
# 1. 이 파일을 .env로 복사:  cp .env.production.example .env
# 2. 모든 CHANGE_ME 값을 실제 값으로 변경
# 3. 민감한 정보가 포함되어 있으므로 절대 Git에 커밋하지 마세요
#
# ===================================================================

# -------------------------------------------------------------------
# Global / Infrastructure
# -------------------------------------------------------------------
DOMAIN=platform.example.com
SSL_CERT_EMAIL=admin@example.com

# -------------------------------------------------------------------
# JWT 공유 시크릿 (필수)
# -------------------------------------------------------------------
# 크로스 모듈 인증: FDD에서 로그인 → KIIS/IM/MA에서 동일 토큰 검증
# docker-compose.prod.yml이 이 변수 하나로 모든 백엔드에 주입합니다.
# 생성: openssl rand -base64 48  또는  pwgen -s 64 1
SHARED_JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# -------------------------------------------------------------------
# FDD Backend (Auto FDD)
# -------------------------------------------------------------------
FDD_DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
# FDD는 str 형식 (쉼표 구분) — cors_origins: str
FDD_CORS_ORIGINS=https://ap-platform.kr,http://52.231.69.38
FDD_LOG_LEVEL=INFO

# -------------------------------------------------------------------
# KIIS Backend
# -------------------------------------------------------------------
KIIS_DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
# KIIS는 JSON 배열 형식 필수 (ALLOWED_ORIGINS: list[str])
KIIS_CORS_ORIGINS=["https://ap-platform.kr","http://52.231.69.38"]
KIIS_LOG_LEVEL=WARNING

# DART API (https://opendart.fss.or.kr)
DART_API_KEY=CHANGE_ME_TO_YOUR_DART_API_KEY

# Redis (KIIS)
KIIS_REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Elasticsearch (KIIS)
KIIS_ES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# -------------------------------------------------------------------
# IM Backend (Auto-IM Generator)
# -------------------------------------------------------------------
IM_DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
# IM은 JSON 배열 형식 필수 (allowed_origins: list[str], alias CORS_ORIGINS)
IM_CORS_ORIGINS=["https://ap-platform.kr","http://52.231.69.38"]
IM_LOG_LEVEL=WARNING

# Redis (IM)
IM_REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# OpenAI API
OPENAI_API_KEY=CHANGE_ME_TO_YOUR_OPENAI_API_KEY

# Anthropic Claude API
ANTHROPIC_API_KEY=CHANGE_ME_TO_YOUR_ANTHROPIC_API_KEY

# Google Gemini API (IM Multi-Model Routing)
GEMINI_API_KEY=CHANGE_ME_TO_YOUR_GEMINI_API_KEY

# Brandfetch API
BRANDFETCH_API_KEY=CHANGE_ME_TO_YOUR_BRANDFETCH_API_KEY

# Pinecone Vector DB
PINECONE_API_KEY=CHANGE_ME_TO_YOUR_PINECONE_API_KEY
PINECONE_ENVIRONMENT=CHANGE_ME_TO_YOUR_PINECONE_ENV

# -------------------------------------------------------------------
# M&A Deal Management Backend (deal-mgmt)
# -------------------------------------------------------------------
MA_DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
# deal-mgmt는 JSON 배열 형식 필수 (ALLOWED_ORIGINS: list[str])
MA_CORS_ORIGINS=["https://ap-platform.kr","http://52.231.69.38"]

# -------------------------------------------------------------------
# Monitoring (Optional)
# -------------------------------------------------------------------
SENTRY_DSN=CHANGE_ME_TO_YOUR_SENTRY_DSN
SENTRY_ENVIRONMENT=production

# -------------------------------------------------------------------
# CI/CD — Sentry Source Map Upload (GitHub Actions Secrets로 관리)
# -------------------------------------------------------------------
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SENTRY_ORG=your_sentry_org
# SENTRY_PROJECT=your_sentry_project
