{
  "name": "LDD Full Report PRD",
  "version": "1.0",
  "document_type": "LDD_FULL",
  "description": "법률실사(Legal Due Diligence) 전체 보고서 품질 요구사항",
  "pass_threshold": 4.0,
  "sections": {
    "GOVERNANCE": {
      "title": "1. 기업 일반 및 지배구조",
      "required": true,
      "min_items": 5,
      "criteria": {
        "completeness": "설립/등기/정관/이사회/주주명부/임원 등 핵심 6개 항목 전부 검토",
        "depth": "각 항목별 근거 문서(정관, 등기사항증명서 등) 구체적 인용",
        "deal_impact": "지배구조 변동이 거래에 미치는 영향 명시"
      }
    },
    "CAPITAL": {
      "title": "2. 자본구조 및 주주협약",
      "required": true,
      "min_items": 5,
      "criteria": {
        "completeness": "발행주식/CB/BW/ESOP/우선주/주주협약 전부 검토",
        "accuracy": "주식 수, 발행가, 전환비율 등 수치 정확성",
        "deal_impact": "자본구조가 거래 가격/구조에 미치는 영향"
      }
    },
    "CONTRACTS": {
      "title": "3. 주요 계약",
      "required": true,
      "min_items": 5,
      "criteria": {
        "coc_check": "모든 주요 계약의 Change of Control 조항 확인 필수",
        "materiality": "매출집중도, 대체가능성, 종료조건 등 중요성 평가",
        "deal_impact": "계약 해지/변경 시 거래에 미치는 재무적 영향 구체화"
      }
    },
    "LITIGATION": {
      "title": "4. 소송 및 분쟁",
      "required": true,
      "min_items": 4,
      "criteria": {
        "completeness": "진행 중/잠재적 민사·형사·행정 절차 모두 포함",
        "quantification": "청구금액, 예상 패소 확률, 우발채무 규모 기재",
        "deal_impact": "소송 결과가 거래 가격/구조에 미치는 영향"
      }
    },
    "LABOR": {
      "title": "5. 인사 및 노무",
      "required": true,
      "min_items": 5,
      "criteria": {
        "compliance": "근로기준법, 노동조합법 준수 여부 확인",
        "financial": "미지급 임금, 퇴직급여 충당금 적정성 평가",
        "deal_impact": "노무 리스크가 거래에 미치는 영향"
      }
    },
    "IP": {
      "title": "6. 지식재산권",
      "required": true,
      "min_items": 4,
      "criteria": {
        "ownership": "IP 소유권 귀속 명확성 확인",
        "validity": "특허/상표/저작권 유효기간 및 갱신 상태",
        "third_party": "제3자 IP 침해 가능성 평가"
      }
    },
    "REAL_ESTATE": {
      "title": "7. 부동산 및 환경",
      "required": true,
      "min_items": 4,
      "criteria": {
        "title_search": "등기부 등본 기반 소유권/제한물권 확인",
        "environmental": "환경오염 이력 및 오염토양 조사 결과",
        "deal_impact": "부동산/환경 이슈가 거래에 미치는 영향"
      }
    },
    "PERMITS": {
      "title": "8. 인허가 및 규제",
      "required": true,
      "min_items": 4,
      "criteria": {
        "validity": "핵심 인허가 유효성 및 갱신 조건",
        "coc_impact": "경영권 변동 시 인허가 영향 분석",
        "regulatory": "공정거래/기업결합신고 해당 여부"
      }
    },
    "TAX": {
      "title": "9. 조세",
      "required": true,
      "min_items": 4,
      "criteria": {
        "compliance": "최근 3년 세무신고/납부 적정성",
        "exposure": "추가 납부/가산세 노출 금액 추정",
        "transfer_pricing": "특수관계인 거래 이전가격 적정성"
      }
    },
    "DATA_IT": {
      "title": "10. 개인정보 및 IT",
      "required": true,
      "min_items": 3,
      "criteria": {
        "pipa": "개인정보보호법(PIPA) 준수 여부",
        "certification": "ISMS/ISO 인증 현황",
        "incidents": "보안사고/데이터 유출 이력"
      }
    }
  },
  "global_criteria": {
    "executive_summary": "Critical/High 이슈 요약, 전체 의견 포함 필수",
    "rfi_numbering": "{SECTION_PREFIX}-NNN 형식 일관성",
    "cross_references": "섹션 간 교차 참조 정합성",
    "terminology": "한국 법률/재무 용어 일관적 사용"
  }
}
