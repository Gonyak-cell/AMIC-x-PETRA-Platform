# ============================================================
# AMIC x PETRA Platform — 통합 환경변수 (개발)
# ============================================================
# 사용법: cp .env.example .env
# ============================================================

# -----------------------------------------------------------
# 공유 JWT Secret (3개 백엔드 공통)
# -----------------------------------------------------------
JWT_SECRET=dev-shared-jwt-secret-change-in-production

# -----------------------------------------------------------
# FDD Backend (Auto FDD)
# -----------------------------------------------------------
FDD_DB_PASSWORD=autofdd_dev

# -----------------------------------------------------------
# KIIS Backend
# -----------------------------------------------------------
KIIS_DB_PASSWORD=kiis_dev_password

# DART API (https://opendart.fss.or.kr)
DART_API_KEY=your-dart-api-key-here

# -----------------------------------------------------------
# IM Backend (Auto-IM Generator)
# -----------------------------------------------------------
IM_DB_PASSWORD=postgres
IM_SECRET_KEY=dev-secret-im-change-me

# OpenAI API (https://platform.openai.com)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Brandfetch API (https://brandfetch.com/developers)
BRANDFETCH_API_KEY=your-brandfetch-api-key-here

# Pinecone Vector DB (https://www.pinecone.io)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-env-here
