# ============================================================
# AMIC x PETRA Platform — Telegram Bot Configuration
# ============================================================
# 이 파일을 복사하여 .env 로 저장한 뒤 실제 값을 입력하세요.
# cp .env.example .env
#
# 텔레그램 봇 생성 방법:
#   1. 텔레그램에서 @BotFather 검색 → /newbot → 봇 생성 → 토큰 복사
#   2. 텔레그램에서 @userinfobot 검색 → 아무 메시지 → 숫자 ID 확인
# ============================================================

# [필수] BotFather에서 받은 봇 토큰
TELEGRAM_BOT_TOKEN=your_bot_token_here

# [필수] 허가된 텔레그램 사용자 ID (쉼표로 여러 명 가능)
TELEGRAM_USER_IDS=123456789

# Claude CLI 설정
DEFAULT_MODEL=sonnet
CLAUDE_TIMEOUT=300
MAX_TURNS=10
MAX_BUDGET_USD=2.00

# 로깅
LOG_LEVEL=INFO
