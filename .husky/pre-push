#!/bin/sh
# ─── Guard 1: deploy.yml 권한 블록 보존 ───────────────────────────────────
# wait-for-ci 단계에 gh api /check-runs 호출 시 'checks: read' 권한 필수.
# deploy.yml 수정 시 실수로 permissions 블록을 제거하면 403 에러로 Deploy 실패.
DEPLOY_YML=".github/workflows/deploy.yml"
if [ -f "$DEPLOY_YML" ]; then
  if ! grep -q "checks: read" "$DEPLOY_YML"; then
    echo ""
    echo "❌ PRE-PUSH BLOCKED: .github/workflows/deploy.yml에 'checks: read' 권한이 없습니다."
    echo "   wait-for-ci 단계의 gh api /check-runs 호출에 필수입니다."
    echo "   deploy.yml의 permissions 블록에 'checks: read'를 추가하세요:"
    echo ""
    echo "   permissions:"
    echo "     checks: read"
    echo "     contents: read"
    echo ""
    exit 1
  fi
fi

# ─── Guard 2: SQLAlchemy 모델 JSONB/UUID 크로스 DB 호환성 경고 ─────────────
# PostgreSQL 전용 JSONB/UUID를 직접 사용하면 SQLite CI 테스트가 깨짐.
# JSON().with_variant(JSONB, "postgresql") 및 Uuid 사용 필요.
STAGED_MODELS=$(git diff --cached --name-only 2>/dev/null | grep -E "(models/.*\.py|app/models/.*\.py)$" || true)
if [ -n "$STAGED_MODELS" ]; then
  RAW_JSONB=$(git diff --cached -- "*.py" 2>/dev/null | grep "^+" | grep -E "mapped_column\(JSONB|mapped_column\(UUID\(as_uuid" | grep -v "with_variant" || true)
  if [ -n "$RAW_JSONB" ]; then
    echo ""
    echo "⚠️  WARNING: SQLAlchemy 모델에 PostgreSQL 전용 타입 직접 사용 감지:"
    echo "$RAW_JSONB"
    echo ""
    echo "   SQLite CI 테스트 실패 가능성이 있습니다."
    echo "   권장: JSON().with_variant(JSONB, 'postgresql') / Uuid"
    echo "   (경고만 출력, 푸시는 계속됩니다)"
    echo ""
  fi
fi

# ─── Guard 3: TypeScript 타입 체크 ────────────────────────────────────────
cd amic-platform

if [ ! -d "node_modules" ]; then
  echo "node_modules not found in amic-platform/. Run 'npm install' first."
  exit 1
fi

echo "Pre-push: Running TypeScript type check..."
npx tsc --noEmit

if [ $? -ne 0 ]; then
  echo "TypeScript errors found. Push aborted."
  exit 1
fi

echo "TypeScript check passed."
