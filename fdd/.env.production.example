# ===================================================
# Auto FDD — Production Environment Variables
# ===================================================
# Copy this file to .env.production and fill in all values.
# NEVER commit .env.production to version control.

# ── Database ──
POSTGRES_USER=fdd_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fdd_prod

# ── Backend ──
AUTH_ENABLED=true
UPLOAD_DIR=/data/uploads
LOG_LEVEL=INFO
ENGINE_VERSION=0.1.0

# ── Auth (JWT) ──
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_STRING
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# ── CORS ──
# Comma-separated origins (no trailing slashes)
CORS_ORIGINS=https://fdd.example.com

# ── Frontend ──
VITE_API_BASE_URL=/api/v1

# ── SSL/TLS ──
# Set to "true" to enable HTTPS via nginx
SSL_ENABLED=false
# Domain name for SSL certificate
SSL_DOMAIN=fdd.example.com
# Email for Let's Encrypt notifications
SSL_EMAIL=admin@example.com

# ── Monitoring ──
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_RETENTION=30d

# ── PPTX Service ──
PPTX_SERVICE_URL=http://pptx-service:3100

# ── LLM API Keys (at least one required for AI agents) ──
# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-api03-...
# OpenAI GPT
# OPENAI_API_KEY=sk-...
# Google Gemini
# GOOGLE_API_KEY=AIza...

# ── External Integrations (optional) ──
# SENTRY_DSN=https://xxx@sentry.io/yyy
# SLACK_WEBHOOK=https://hooks.slack.com/services/xxx
