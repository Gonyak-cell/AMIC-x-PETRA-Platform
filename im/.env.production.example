# ===================================================================
# Auto-IM Generator - Production Environment Configuration
# ===================================================================
#
# 사용법:
# 1. 이 파일을 .env.production으로 복사
# 2. 모든 CHANGE_ME 값을 실제 값으로 변경
# 3. 민감한 정보가 포함되어 있으므로 절대 Git에 커밋하지 마세요
#
# ===================================================================

# -------------------------------------------------------------------
# Application Settings
# -------------------------------------------------------------------
DEBUG=false
ENV=production
LOG_LEVEL=WARNING
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# -------------------------------------------------------------------
# API Settings
# -------------------------------------------------------------------
API_TITLE=Auto-IM Generator API
API_VERSION=1.0.0
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# CORS
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_CREDENTIALS=true

# -------------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------------
POSTGRES_USER=auto_im_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=auto_im_generator
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full database URL (auto-constructed if not set)
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30

# -------------------------------------------------------------------
# Redis
# -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
REDIS_DB=0

# Full Redis URL (auto-constructed if not set)
# REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -------------------------------------------------------------------
# Celery
# -------------------------------------------------------------------
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# -------------------------------------------------------------------
# OpenAI
# -------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME_TO_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000
OPENAI_TIMEOUT=60

# -------------------------------------------------------------------
# Pinecone (Vector Database)
# -------------------------------------------------------------------
PINECONE_API_KEY=CHANGE_ME_TO_YOUR_PINECONE_API_KEY
PINECONE_ENVIRONMENT=CHANGE_ME_TO_YOUR_PINECONE_ENV
PINECONE_INDEX_NAME=auto-im-generator-prod
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine

# -------------------------------------------------------------------
# JWT Authentication
# -------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------------------
# Email (Optional - for notifications)
# -------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_TO_YOUR_EMAIL
SMTP_PASSWORD=CHANGE_ME_TO_YOUR_APP_PASSWORD
SMTP_FROM=noreply@yourdomain.com
SMTP_TLS=true

# -------------------------------------------------------------------
# File Storage
# -------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/output
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes

# -------------------------------------------------------------------
# Monitoring & Logging
# -------------------------------------------------------------------
SENTRY_DSN=CHANGE_ME_TO_YOUR_SENTRY_DSN
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# -------------------------------------------------------------------
# SSL/TLS
# -------------------------------------------------------------------
DOMAIN=api.yourdomain.com
SSL_CERT_EMAIL=admin@yourdomain.com

# -------------------------------------------------------------------
# Backup
# -------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=CHANGE_ME_TO_YOUR_S3_BUCKET
AWS_ACCESS_KEY_ID=CHANGE_ME_TO_YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_TO_YOUR_AWS_SECRET
AWS_REGION=ap-northeast-2

# -------------------------------------------------------------------
# Feature Flags
# -------------------------------------------------------------------
ENABLE_REGISTRATION=false
ENABLE_PASSWORD_RESET=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_ADMIN_PANEL=true

# -------------------------------------------------------------------
# Performance
# -------------------------------------------------------------------
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100
TIMEOUT=120
KEEPALIVE=5
