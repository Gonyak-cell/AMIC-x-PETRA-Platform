# ============================================================
# IM Auto-Generator 환경변수 설정
# ============================================================
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요.
# cp .env.example .env

# Open DART API (https://opendart.fss.or.kr)
DART_API_KEY=your_dart_api_key_here

# OpenAI API (https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_NAME=claude-sonnet-4-20250514

# Google Gemini API (https://ai.google.dev)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL_NAME=gemini-2.0-flash

# Brandfetch API (https://brandfetch.com/developers)
BRANDFETCH_API_KEY=your_brandfetch_api_key_here

# Pinecone Vector DB (https://www.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_env_here

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/imgen

# Redis
REDIS_URL=redis://localhost:6379/0

# Multi-Model Routing
# JSON format: {"section_id": "provider_name"}
# Provider names: openai, anthropic, google
# Leave empty to use default routing
LLM_ROUTING_MAP=
# Fallback priority (comma-separated)
LLM_FALLBACK_ORDER=openai,anthropic,google

# Application
SECRET_KEY=your_secret_key_here
DEBUG=true
LOG_LEVEL=INFO
