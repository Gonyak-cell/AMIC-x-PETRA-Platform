# ===================================================================
# Auto-IM Generator - Staging Environment Configuration
# ===================================================================
#
# 사용법:
# 1. 이 파일을 .env.staging으로 복사
# 2. 모든 CHANGE_ME 값을 실제 값으로 변경
# 3. Staging은 Production과 유사하지만 디버깅이 활성화됨
#
# ===================================================================

# -------------------------------------------------------------------
# Application Settings
# -------------------------------------------------------------------
DEBUG=true
ENV=staging
LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING

# -------------------------------------------------------------------
# API Settings
# -------------------------------------------------------------------
API_TITLE=Auto-IM Generator API (Staging)
API_VERSION=1.0.0-staging
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# Rate Limiting (더 관대한 설정)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# CORS (더 관대한 설정)
CORS_ORIGINS=https://staging.yourdomain.com,http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# -------------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------------
POSTGRES_USER=auto_im_user_staging
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=auto_im_generator_staging
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database connection pool (Staging은 작은 풀)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# -------------------------------------------------------------------
# Redis
# -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
REDIS_DB=0

# -------------------------------------------------------------------
# Celery
# -------------------------------------------------------------------
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# -------------------------------------------------------------------
# OpenAI
# -------------------------------------------------------------------
OPENAI_API_KEY=CHANGE_ME_TO_YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4000
OPENAI_TIMEOUT=60

# -------------------------------------------------------------------
# Pinecone (Vector Database)
# -------------------------------------------------------------------
PINECONE_API_KEY=CHANGE_ME_TO_YOUR_PINECONE_API_KEY
PINECONE_ENVIRONMENT=CHANGE_ME_TO_YOUR_PINECONE_ENV
PINECONE_INDEX_NAME=auto-im-generator-staging
PINECONE_DIMENSION=1536
PINECONE_METRIC=cosine

# -------------------------------------------------------------------
# JWT Authentication
# -------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60  # Staging은 더 긴 토큰 만료 시간
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14

# -------------------------------------------------------------------
# Email (Optional - for notifications)
# -------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_TO_YOUR_EMAIL
SMTP_PASSWORD=CHANGE_ME_TO_YOUR_APP_PASSWORD
SMTP_FROM=staging-noreply@yourdomain.com
SMTP_TLS=true

# -------------------------------------------------------------------
# File Storage
# -------------------------------------------------------------------
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/output
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes

# -------------------------------------------------------------------
# Monitoring & Logging
# -------------------------------------------------------------------
SENTRY_DSN=CHANGE_ME_TO_YOUR_SENTRY_DSN
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1.0  # Staging은 모든 트레이스 샘플링

# -------------------------------------------------------------------
# SSL/TLS
# -------------------------------------------------------------------
DOMAIN=staging-api.yourdomain.com
SSL_CERT_EMAIL=admin@yourdomain.com

# -------------------------------------------------------------------
# Backup
# -------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=7  # Staging은 짧은 보관 기간
BACKUP_S3_BUCKET=CHANGE_ME_TO_YOUR_S3_BUCKET_STAGING
AWS_ACCESS_KEY_ID=CHANGE_ME_TO_YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_TO_YOUR_AWS_SECRET
AWS_REGION=ap-northeast-2

# -------------------------------------------------------------------
# Feature Flags (Staging은 모든 기능 활성화)
# -------------------------------------------------------------------
ENABLE_REGISTRATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_EMAIL_VERIFICATION=false  # Staging은 이메일 검증 비활성화
ENABLE_ADMIN_PANEL=true

# -------------------------------------------------------------------
# Performance (Staging은 작은 리소스)
# -------------------------------------------------------------------
WORKERS=2
WORKER_CLASS=uvicorn.workers.UvicornWorker
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100
TIMEOUT=120
KEEPALIVE=5

# -------------------------------------------------------------------
# Testing & Development
# -------------------------------------------------------------------
ENABLE_SWAGGER_UI=true
ENABLE_REDOC=true
ENABLE_DEBUG_TOOLBAR=true
SQLALCHEMY_ECHO=false  # SQL 쿼리 로깅 (필요시 true)
