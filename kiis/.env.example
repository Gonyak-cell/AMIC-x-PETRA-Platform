# =============================================================================
# KIIS - Korea Investment Intelligence System
# Environment Variables Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Application display name
APP_NAME=KIIS

# Enable debug mode (set to true for development, false for production)
DEBUG=true

# Secret key for JWT token signing and session encryption
# IMPORTANT: Generate a strong random key for production!
# Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-random-secret-key

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Async PostgreSQL connection URL
# Format: postgresql+asyncpg://{user}:{password}@{host}:{port}/{database}
DATABASE_URL=postgresql+asyncpg://kiis_user:kiis_dev_password@localhost:5432/kiis

# PostgreSQL password (used by docker-compose for container initialization)
POSTGRES_PASSWORD=kiis_dev_password

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# Redis connection URL
# Format: redis://{host}:{port}/{db_number}
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# ElasticSearch
# -----------------------------------------------------------------------------
# ElasticSearch connection URL (leave empty to disable)
ELASTICSEARCH_URL=http://localhost:9200

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# JWT signing algorithm
JWT_ALGORITHM=HS256

# Access token expiration time in minutes
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration time in days
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# DART API (금융감독원 전자공시)
# -----------------------------------------------------------------------------
# DART Open API key - obtain from https://opendart.fss.or.kr/
DART_API_KEY=your-dart-api-key-here

# DART API base URL
DART_BASE_URL=https://opendart.fss.or.kr/api

# Rate limiting: requests per minute (official limit: 1000, safety margin: 900)
DART_RATE_LIMIT_PER_MINUTE=900

# Rate limiting: requests per day (official limit: 10000, safety margin: 9000)
DART_RATE_LIMIT_PER_DAY=9000

# -----------------------------------------------------------------------------
# KOFIA (금융투자협회)
# -----------------------------------------------------------------------------
# KOFIA DIS (Disclosure Information System) base URL
KOFIA_DIS_BASE_URL=https://dis.kofia.or.kr

# Rate limiting: requests per minute (3-second interval = ~20 req/min)
KOFIA_RATE_LIMIT_PER_MINUTE=20

# Rate limiting: requests per day
KOFIA_RATE_LIMIT_PER_DAY=1000

# Minimum delay between requests in seconds (robots.txt compliance)
KOFIA_REQUEST_DELAY=3.0

# -----------------------------------------------------------------------------
# REITs (리츠정보시스템)
# -----------------------------------------------------------------------------
# REITs information system base URL
REITS_BASE_URL=https://reits.molit.go.kr

# Rate limiting: requests per minute (3-second interval = ~20 req/min)
REITS_RATE_LIMIT_PER_MINUTE=20

# Rate limiting: requests per day
REITS_RATE_LIMIT_PER_DAY=500

# Minimum delay between requests in seconds (robots.txt compliance)
REITS_REQUEST_DELAY=3.0
